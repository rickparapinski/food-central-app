# Copy this file to .env and fill in the values
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite file next to the project root
# Production: file:/data/food-central/food-central.db
DATABASE_URL="file:./dev.db"

# ── Claude API ────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/settings/keys
# Used for: meal plan generation (POST /api/meal-plan) and OCR (POST /api/ocr)
# Model: claude-haiku-4-5-20251001 (see src/lib/claude.ts)
CLAUDE_API_KEY="your-key-here"

# ── Photo storage ─────────────────────────────────────────────────────────────
# Where nutrition label photos are saved after OCR
# Local dev: ./public/photos (served statically by Next.js)
# Production: /data/food-central/photos
PHOTO_STORAGE_PATH="./public/photos"
